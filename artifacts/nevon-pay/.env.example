# Nevon Pay — variáveis de ambiente
# Copie para `.env` (local) ou configure nos Secrets do alojamento.
# NUNCA versione o ficheiro `.env` real.

# ---------------------------------------------------------------- Base de dados
# Canónica: connection string PostgreSQL do Supabase.
# Use a "Session pooler" (porta 5432) para o Prisma em runtime e a "Direct
# connection" (porta 5432, host db.<ref>.supabase.co) para `prisma migrate`.
# Recomendado: role dedicado da aplicação (ex.: nevon_app), não o superuser
# `postgres`. No Session pooler o utilizador tem o formato <role>.<ref>.
DATABASE_URL="postgresql://nevon_app.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public&sslmode=require&connection_limit=5"

# Opcional. Só é usada se DATABASE_URL não existir (compatibilidade com o
# histórico do projeto). Se ambas estiverem definidas e apontarem para bases de
# dados diferentes, /api/health mostra um aviso e a aplicação usa DATABASE_URL.
# SUPABASE_DATABASE_URL=""

# ------------------------------------------------------------------- Supabase
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
# Chave publicável (sb_publishable_...) ou, em projetos antigos, a anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# URL público da aplicação (usado nos links de confirmação/recuperação)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------- Geral
APP_ENV=development
PORT=3000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# ------------------------------------------------------- Email (notificações)
# Desactivado por omissão: sem estas variáveis as notificações são registadas
# na base de dados mas nenhum email é enviado (e o dashboard informa isso).
#
# Notifica (api.notifica.co.mz) — recomendado para Moçambique.
# O `from` tem de ser um dos remetentes verificados da conta; liste-os em
# GET https://api.notifica.co.mz/api/v1/email/senders
EMAIL_PROVIDER=notifica        # notifica | resend | brevo | webhook
EMAIL_API_KEY=
EMAIL_FROM="notification@notifica.co.mz"
# EMAIL_ENDPOINT="https://api.notifica.co.mz/api/v1/email/send"   # opcional

# Outros fornecedores
# EMAIL_PROVIDER=resend
# EMAIL_FROM="Nevon Pay <no-reply@seudominio.mz>"
# EMAIL_WEBHOOK_URL=           # apenas para EMAIL_PROVIDER=webhook
