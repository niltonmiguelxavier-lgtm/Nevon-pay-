{
  "expo": {
    "name": "Nevon Pay",
    "slug": "nevon-pay",
    "scheme": "nevonpay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f8f7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mz.nevonpay.merchant",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "mz.nevonpay.merchant",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#126e50"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font"
    ],
    "owner": "nevon-group",
    "extra": {
      "eas": {
        "projectId": "9f38c964-2c52-4bc6-9103-fd4aa0cbf88f"
      }
    }
  }
}
